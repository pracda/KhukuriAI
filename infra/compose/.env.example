# Copy to .env and set real values. .env is gitignored.
POSTGRES_PASSWORD=change-me
CLICKHOUSE_PASSWORD=change-me

# apps profile (docker compose --profile apps up)
IDENTITY_ADMIN_PASSWORD=change-me
IDENTITY_CLIENT_GATEWAY_SECRET=change-me

# OTel Collector -> Ingest. Issue the key from Identity:
#   POST /api/v1/tenants/<slug>/keys  {"type":"INGEST"}
KHUKURI_INGEST_ENDPOINT=http://ingest:8182
KHUKURI_INGEST_KEY=khk_ing_replace-me
